# Bun API and worker only. Copy to .env; never expose these through VITE_*.
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=
PORT=3001
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
SITE_URL=http://localhost:5173
DEEPSEEK_API_KEY=
GENERATION_WEBHOOK_SECRET=
SUME_API_KEY=

# Workspace notification emails (Nodemailer SMTP)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
# Optional exact trusted reverse-proxy socket IPs for email-login rate limiting.
# Leave blank for direct API connections; never trust arbitrary forwarded headers.
AUTH_TRUSTED_PROXY_IPS=

# Enable real providers only after configuring their keys above.
ENABLED_PROVIDERS=deepseek,sume
PROVIDER_TIMEOUT_MS=120000
PROVIDER_READ_RETRIES=2

# USD rates and supplier-cost safety checks are versioned in shared/pricing.ts.
# Set in Convex separately only for development USD funding fixtures.

# Polar payments — disabled until configured; use separate sandbox/live product IDs.
POLAR_PAYMENTS_ENABLED=false
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_WORKSPACE_PRODUCT_ID=
POLAR_TOPUP_10_PRODUCT_ID=
POLAR_TOPUP_25_PRODUCT_ID=
POLAR_TOPUP_50_PRODUCT_ID=

# Activate only after configuring Polar; false preserves unbound development/beta workspaces.
SUBSCRIPTION_PAYWALL_ENABLED=false
# Enable seven-day workspace trial enrollment. Started trials survive disabling enrollment.
WORKSPACE_TRIAL_ENABLED=false

# Cloudflare R2 (server-only; private media storage).
# Use separate development/production buckets and bucket-scoped credentials.
# R2_ENDPOINT: copy the S3 API endpoint from Cloudflare R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public Docker Compose build arguments (also used by Dokploy).
# Production: replace every localhost value with its public HTTPS origin.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_API_URL=http://localhost:8082
VITE_WEB_URL=http://localhost:8080
VITE_ADMIN_URL=http://localhost:8081
VITE_APP_ENV=production
API_PORT=8082
WEB_PORT=8080
ADMIN_PORT=8081
RELEASE_VERSION=local

# First-party product support (API + worker, server-only).
# Defaults to the existing DeepSeek provider; no customer credits are charged.
SUPPORT_AI_ENABLED=true
SUPPORT_AI_DAILY_CALL_LIMIT=500
# Optional dedicated OpenAI-compatible provider (HTTPS API prefix).
SUPPORT_AI_API_KEY=
SUPPORT_AI_BASE_URL=
SUPPORT_AI_MODEL=
