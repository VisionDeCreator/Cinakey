# Bun API and worker only. Copy to .env; never expose these through VITE_*.
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=
PORT=3001
WEB_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
DEEPSEEK_API_KEY=
GENERATION_WEBHOOK_SECRET=
USE_MOCK_ADAPTERS=true
SUME_API_KEY=

# Workspace notification emails (Nodemailer SMTP)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
# Optional exact trusted reverse-proxy socket IPs for email-login rate limiting.
# Leave blank for direct API connections; never trust arbitrary forwarded headers.
AUTH_TRUSTED_PROXY_IPS=

# Enable real providers only after configuring their keys above.
ENABLED_PROVIDERS=deepseek,sume
PROVIDER_TIMEOUT_MS=120000
PROVIDER_READ_RETRIES=2

# USD rates and supplier-cost safety checks are versioned in shared/pricing.ts.
# Set in Convex separately only for development USD funding fixtures.
# ALLOW_DEV_USD=true

# Polar payments — disabled until configured; use separate sandbox/live product IDs.
POLAR_PAYMENTS_ENABLED=false
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_WORKSPACE_PRODUCT_ID=
POLAR_TOPUP_10_PRODUCT_ID=
POLAR_TOPUP_25_PRODUCT_ID=
POLAR_TOPUP_50_PRODUCT_ID=

# Activate only after configuring Polar; false preserves unbound development/beta workspaces.
SUBSCRIPTION_PAYWALL_ENABLED=false
