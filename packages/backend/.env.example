# Deployment used by `npx convex dev` (run from packages/backend)
CONVEX_DEPLOYMENT=

# Provider keys and job flags are set via `npx convex env set` (never commit values):
# OPENAI_API_KEY
# SUME_API_KEY
# DEEPSEEK_API_KEY
# GENERATION_WEBHOOK_SECRET
# SMTP_* and EMAIL_NOTIFICATIONS_ENABLED live in the root .env for the Bun API/worker.
# EMAIL_FROM              (e.g. Cinakey <noreply@yourdomain.com>)

# Staff: set users.isStaff=true in the Convex dashboard, then use /staff

# Non-secret payment deployment mode; set with convex env set when enabling Polar.
POLAR_ENVIRONMENT=sandbox

# Activate only after configuring Polar; false preserves unbound development/beta workspaces.
SUBSCRIPTION_PAYWALL_ENABLED=false
