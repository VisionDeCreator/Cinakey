# Local Convex deployment selector; production configuration lives in deployments/convex/.env.
CONVEX_DEPLOYMENT=
# Configure runtime variables through the Convex CLI, not this local selector file:
# JWT_PRIVATE_KEY, JWKS, SITE_URL, optional AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
# STAGING_LLM_ENABLED, POLAR_ENVIRONMENT, SUBSCRIPTION_PAYWALL_ENABLED
# Provider, webhook, R2 and SMTP credentials belong only to API/worker runtime files.
