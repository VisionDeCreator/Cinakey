{
  "name": "dirrio",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun run check:secrets && bun run test:deployment && bun run check:i18n && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "dev:convex": "bun run --cwd packages/backend dev",
    "check:secrets": "bun --no-env-file scripts/check-secrets.ts",
    "dev:admin": "bun run --cwd apps/admin dev",
    "admin:promote": "bun --no-env-file scripts/promote-admin.ts",
    "check:i18n": "bun --no-env-file scripts/i18n/check.cjs",
    "docker:api": "docker compose --env-file deployments/api/.env -f deployments/api/docker-compose.yml up --build -d",
    "docker:worker": "docker compose --env-file deployments/worker/.env -f deployments/worker/docker-compose.yml up --build -d",
    "docker:web": "docker compose --env-file deployments/web/.env -f deployments/web/docker-compose.yml up --build -d",
    "docker:admin": "docker compose --env-file deployments/admin/.env -f deployments/admin/docker-compose.yml up --build -d",
    "docker:all": "docker compose -f docker-compose.yml up --build -d",
    "deploy:check": "bun --no-env-file deployments/scripts/check-env.ts root",
    "deploy:convex": "bash deployments/convex/deploy.sh",
    "sync:convex-env": "bash deployments/convex/sync-env.sh",
    "setup:convex-auth-keys": "bash deployments/convex/setup-auth-keys.sh",
    "docker:build": "docker compose build",
    "deploy:smoke": "bash deployments/scripts/smoke-test.sh",
    "test:deployment": "bun --no-env-file test deployments/scripts/check-env.test.ts",
    "podman:api": "podman compose --env-file deployments/api/.env -f deployments/api/docker-compose.yml up --build -d",
    "podman:worker": "podman compose --env-file deployments/worker/.env -f deployments/worker/docker-compose.yml up --build -d",
    "podman:web": "podman compose --env-file deployments/web/.env -f deployments/web/docker-compose.yml up --build -d",
    "podman:admin": "podman compose --env-file deployments/admin/.env -f deployments/admin/docker-compose.yml up --build -d",
    "podman:all": "podman compose -f docker-compose.yml up --build -d",
    "deploy:check:services": "bun --no-env-file deployments/scripts/check-env.ts all"
  },
  "devDependencies": {
    "@dirrio/config": "*",
    "prettier": "^3.9.9",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.3.14"
}
