{
  "name": "cinakey",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun run check:secrets && bun run check:i18n && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "dev:convex": "bun run --cwd packages/backend dev",
    "check:secrets": "bun --no-env-file scripts/check-secrets.ts",
    "dev:admin": "bun run --cwd apps/admin dev",
    "admin:promote": "bun --no-env-file scripts/promote-admin.ts",
    "check:i18n": "bun --no-env-file scripts/i18n/check.cjs"
  },
  "devDependencies": {
    "@cinakey/config": "*",
    "prettier": "^3.9.9",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.3.14"
}
