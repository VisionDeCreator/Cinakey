# CLI credential; never synchronized into Convex runtime.
CONVEX_DEPLOY_KEY=
CONVEX_URL=https://your-deployment.convex.cloud
SITE_URL=https://app.example.com
STAGING_LLM_ENABLED=true
POLAR_ENVIRONMENT=sandbox
SUBSCRIPTION_PAYWALL_ENABLED=false
# Enable seven-day workspace trial enrollment. Started trials survive disabling enrollment.
WORKSPACE_TRIAL_ENABLED=false
# Optional Google login; configure both together.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# JWT_PRIVATE_KEY and JWKS are generated only on explicit auth setup.
