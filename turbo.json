{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@cinakey/shared#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cinakey/backend#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cinakey/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cinakey/worker#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
