    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@cinakey/backend": "*",
    "@cinakey/shared": "*",
    "@convex-dev/auth": "^0.0.95",
    "@elysiajs/cors": "^1.4.2",
    "@polar-sh/sdk": "^1.0.2",
    "convex": "^1.46.0",
    "elysia": "^1.4.28",
    "mediabunny": "^1.60.0",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.11.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
