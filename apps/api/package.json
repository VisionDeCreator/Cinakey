{
  "name": "@cinakey/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./config": "./src/config/env.ts",
    "./load-root-env": "./src/config/load-root-env.ts",
    "./payments-config": "./src/config/polar.ts",
    "./payments-startup": "./src/config/polar-startup.ts"
  },
  "scripts": {
    "dev": "bun --no-env-file --watch src/bootstrap.ts",
    "start": "bun --no-env-file src/bootstrap.ts",
